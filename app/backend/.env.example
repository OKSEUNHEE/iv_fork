# 로컬 Python 실행용 예시입니다. Docker Compose에서는 저장소 루트의 .env에
# 같은 이름의 값을 설정하면 컨테이너에 전달됩니다.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=investment_db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=investment_docs

# 선택 사항: DART 기업 공시 검색
DART_API_KEY=
KOSIS_API_KEY=
BOK_API_KEY=

# 선택 사항: 로컬 Ollama. Docker Compose의 기본값은
# http://host.docker.internal:11434 입니다.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
